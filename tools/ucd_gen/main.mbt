///|
struct Range {
  lo : Int
  hi : Int
  property : String
} derive(Eq, Debug)

///|
suberror DataError {
  InvalidData(String)
} derive(Debug)

///|
fn parse_ucd(text : String, only? : String = "") -> Array[Range] raise {
  let rows : Array[Range] = []
  for raw in text.split("\n") {
    let body = raw.to_owned().split("#").to_array()[0].trim()
    if body.is_empty() {
      continue
    }
    let fields = body.split(";").to_array()
    if fields.length() != 2 {
      raise InvalidData("expected range;property: \{body}")
    }
    let property = fields[1].trim().to_owned()
    if property.is_empty() ||
      !property
      .iter()
      .all(fn(c) { c.is_ascii_alphabetic() || c.is_ascii_digit() || c == '_' }) {
      raise InvalidData("invalid property: \{property}")
    }
    let ends = fields[0].trim().split("..").to_array()
    if ends.length() > 2 {
      raise InvalidData("invalid range: \{body}")
    }
    let lo = @string.parse_int(ends[0], base=16)
    let hi = if ends.length() == 2 {
      @string.parse_int(ends[1], base=16)
    } else {
      lo
    }
    if lo < 0 || hi > 0x10FFFF || lo > hi {
      raise InvalidData("invalid scalar range: \{body}")
    }
    if only == "" || only == property {
      rows.push({ lo, hi, property })
    }
  }
  rows.sort_by(fn(a, b) { a.lo.compare(b.lo) })
  let result : Array[Range] = []
  for row in rows {
    if result.is_empty() {
      result.push(row)
      continue
    }
    let last = result[result.length() - 1]
    if row.lo <= last.hi {
      raise InvalidData("overlapping ranges at \{row.lo}")
    }
    if last.hi + 1 == row.lo && last.property == row.property {
      result[result.length() - 1] = {
        lo: last.lo,
        hi: row.hi,
        property: row.property,
      }
    } else {
      result.push(row)
    }
  }
  result
}

///|
fn emit(
  rows : Array[Range],
  type_name : String,
  function : String,
  default : String,
  source : String,
) -> String {
  let properties : Array[String] = [default]
  for row in rows {
    if !properties.contains(row.property) {
      properties.push(row.property)
    }
  }
  properties.sort()
  let out = StringBuilder()
  out.write_string(
    "// Generated by tools/ucd_gen from Unicode 17.0.0 \{source}.\n",
  )
  out.write_string(
    "// Unicode License v3; see THIRD_PARTY.md. Do not edit.\n\n///|\n",
  )
  out.write_string("pub(all) enum \{type_name} {\n")
  for property in properties {
    out.write_string("  \{property}\n")
  }
  out.write_string("} derive(Eq, Debug)\n\n///|\n")
  out.write_string(
    "pub extend \{type_name} with Eq::{not_equal, equal}\n\n///|\n",
  )
  out.write_string("pub extend \{type_name} with Debug::{to_repr}\n\n///|\n")
  out.write_string(
    "let \{function}_ranges : ReadOnlyArray[(Int, Int, \{type_name})] = [\n",
  )
  for row in rows {
    if row.property != default {
      out.write_string("  (\{row.lo}, \{row.hi}, \{row.property}),\n")
    }
  }
  out.write_string(
    "]\n\n///|\n/// Unicode 17.0.0 property. Invalid code points return the default.\n",
  )
  out.write_string("pub fn \{function}(codepoint : Int) -> \{type_name} {\n")
  out.write_string("  lookup(\{function}_ranges, codepoint, \{default})\n}\n")
  out.to_string()
}

///|
fn main raise {
  let args = @env.args()
  if args.length() != 3 {
    abort(
      "usage: moon run tools/ucd_gen --target native -- INPUT_DIR OUTPUT_DIR",
    )
  }
  let specifications = [
    ("LineBreak.txt", "LineBreak", "line_break", "XX", ""),
    ("WordBreakProperty.txt", "WordBreak", "word_break", "Other", ""),
    (
      "SentenceBreakProperty.txt", "SentenceBreak", "sentence_break", "Other", "",
    ),
    (
      "emoji-data.txt", "EmojiProperty", "emoji_property", "Other", "Extended_Pictographic",
    ),
    (
      "DerivedGeneralCategory.txt", "GeneralCategory", "general_category", "Cn",
      "",
    ),
    ("EastAsianWidth.txt", "EastAsianWidth", "east_asian_width", "N", ""),
  ]
  for spec in specifications {
    let (file, type_name, function, default, only) = spec
    let text = @fs.read_file_to_string(args[1] + "/" + file)
    let rows = parse_ucd(text, only~)
    @fs.write_string_to_file(
      args[2] + "/" + function + ".mbt",
      emit(rows, type_name, function, default, file),
    )
    println("\{file}: \{rows.length()} compressed ranges")
  }
}
